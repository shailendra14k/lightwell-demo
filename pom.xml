    <ns0:groupId>com.redhat</ns0:groupId>
    <ns0:artifactId>lightwell-demo</ns0:artifactId>
    <ns0:version>1.0.0</ns0:version>
    <ns0:name>lightwell-demo</ns0:name>
    <ns0:description>Simple Spring Boot hello service</ns0:description>

    <ns0:properties>
